# URL pública del sitio (para metadata, sitemap, robots y OpenGraph)
NEXT_PUBLIC_SITE_URL=https://tixola.restaurantesourense.com

# ── Camarero virtual (chat con Claude) ─────────────────────────────────────────
# Clave de la API de Anthropic (https://console.anthropic.com/). Sin ella el chat funciona
# igualmente en modo "sin conexión": un motor determinista responde con la carta y el horario.
ANTHROPIC_API_KEY=
# Modelo de Claude. Por defecto claude-opus-5; alternativas más económicas: claude-sonnet-5 / claude-haiku-4-5.
CHAT_MODEL=claude-opus-5
