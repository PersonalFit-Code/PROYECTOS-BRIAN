# Copia este fichero a .env.local y rellénalo. .env.local no se sube a git.

# Clave de la API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Base de datos SQLite local. Vive en /data, que no se sube a git.
DATABASE_URL="file:./data/dev.db"

# Modelos. Escritura (borradores, reutilización) y clasificación (inbox).
# Se pueden cambiar sin tocar código.
CLAUDE_MODEL_WRITER=
CLAUDE_MODEL_CLASSIFIER=
