@page { size: A4; margin: 13mm 14mm; }
@font-face { font-family: "Poppins"; font-weight: 400; src: url(fuentes/poppins-400.woff2) format("woff2"); }
@font-face { font-family: "Poppins"; font-weight: 400; src: url(fuentes/poppins-400-ext.woff2) format("woff2"); unicode-range: U+100-2BA,U+1E00-1EFF,U+20A0-20AB; }
@font-face { font-family: "Poppins"; font-weight: 500; src: url(fuentes/poppins-500.woff2) format("woff2"); }
@font-face { font-family: "Poppins"; font-weight: 600; src: url(fuentes/poppins-600.woff2) format("woff2"); }
@font-face { font-family: "Poppins"; font-weight: 600; src: url(fuentes/poppins-600-ext.woff2) format("woff2"); unicode-range: U+100-2BA,U+1E00-1EFF,U+20A0-20AB; }
@font-face { font-family: "Poppins"; font-weight: 700; src: url(fuentes/poppins-700.woff2) format("woff2"); }
@font-face { font-family: "Poppins"; font-weight: 700; src: url(fuentes/poppins-700-ext.woff2) format("woff2"); unicode-range: U+100-2BA,U+1E00-1EFF,U+20A0-20AB; }
@font-face { font-family: "Poppins"; font-weight: 800; src: url(fuentes/poppins-800.woff2) format("woff2"); }
@font-face { font-family: "Poppins"; font-weight: 800; src: url(fuentes/poppins-800-ext.woff2) format("woff2"); unicode-range: U+100-2BA,U+1E00-1EFF,U+20A0-20AB; }

:root {
  --negro: #0a0a0b; --hueso: #f4f4f5; --linea: #e4e4e7; --fino: #f0f0f2; --humo: #5c5d63;
  --rojo: #dc1f26; --rojo-f: #fdecec;
  --bien: #2E7D4F; --bien-f: #EAF4EE; --mal: #6b6b72; --mal-f: #ececee;
}
* { box-sizing: border-box; }
body {
  margin: 0; font-family: "Poppins", Arial, sans-serif; font-size: 9.6pt; line-height: 1.45; color: var(--negro);
  -webkit-print-color-adjust: exact; print-color-adjust: exact; font-variant-numeric: tabular-nums;
}
.hoja { page-break-after: always; zoom: 1.033; }
.hoja:last-child { page-break-after: auto; }
section, .sit, .tarj, .plan, .cuatro > div, .chat, svg { page-break-inside: avoid; }
svg { display: block; }
svg.f { width: 100%; height: auto; }
b, strong { font-weight: 700; }
p { margin: 0 0 3mm; text-wrap: pretty; }

/* Cabecera, epígrafe, frase grande, pie */
header.interior { display: flex; align-items: center; gap: 3.2mm; border-bottom: 2.5px solid var(--negro); padding-bottom: 2.4mm; margin-bottom: 5mm; }
header.interior .n { font-size: 22pt; font-weight: 800; color: var(--rojo); letter-spacing: -1pt; line-height: 1; }
header.interior h1 { flex: 1; font-size: 15pt; line-height: 1.1; margin: 0; letter-spacing: -.3pt; font-weight: 800; text-transform: uppercase; text-wrap: balance; }
header.interior .lado { display: flex; align-items: center; color: var(--rojo); }
.epigrafe { font-size: 7.6pt; letter-spacing: 2pt; text-transform: uppercase; color: var(--rojo); margin: 0 0 2mm; font-weight: 700; }
.epigrafe::before { content: ""; display: inline-block; width: 6mm; height: .6mm; background: var(--rojo); vertical-align: middle; margin-right: 2.2mm; }
.grande { font-size: 12.2pt; line-height: 1.35; margin: 0 0 3.5mm; text-wrap: balance; }
.grande em { font-style: normal; font-weight: 700; background: linear-gradient(transparent 62%, #fbd3d4 62%); }
.apunte { font-size: 8.2pt; color: var(--humo); margin: 2mm 0 0; }
.pie-hoja { margin-top: 3mm; padding-top: 1.5mm; border-top: 1px solid var(--linea); font-size: 7.6pt; color: var(--humo); display: flex; justify-content: space-between; align-items: center; }
.pie-hoja .izq { display: flex; align-items: center; gap: 1.8mm; }
.pie-hoja .izq svg { color: var(--rojo); }
.pie-hoja .der { display: flex; align-items: center; gap: 2.4mm; }
.pie-hoja .der b { color: var(--negro); }
.dos { display: flex; gap: 4.5mm; align-items: flex-start; }
.dos > * { flex: 1; min-width: 0; }

/* Portada */
.portada { position: relative; overflow: hidden; margin: 0 0 6mm; padding: 0 0 7mm; border-bottom: 2.5px solid var(--negro); }
.portada .p-top { display: flex; justify-content: space-between; align-items: center; font-size: 7.4pt; letter-spacing: 2.2pt; text-transform: uppercase; color: var(--humo); font-weight: 700; margin-bottom: 10mm; }
.portada .p-marca { display: flex; align-items: center; gap: 2mm; color: var(--negro); }
.portada .p-marca svg { color: var(--rojo); }
.portada h1 { position: relative; z-index: 1; font-size: 34pt; line-height: .98; letter-spacing: -1.2pt; margin: 0; font-weight: 800; text-transform: uppercase; max-width: 112mm; text-wrap: balance; }
.portada h1 em { font-style: normal; color: var(--rojo); }
.portada .bajada { position: relative; z-index: 1; font-size: 12pt; line-height: 1.38; color: #3a3a40; max-width: 104mm; margin: 5.5mm 0 0; }
.portada .p-pie { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-end; font-size: 8.4pt; color: var(--humo); margin-top: 7mm; }
.portada .p-pie b { color: var(--negro); }
.portada .p-barra { width: 34mm; height: 2.2mm; background: var(--rojo); margin-bottom: 3mm; }
.portada .p-deco { position: absolute; right: -4mm; top: 10mm; width: 74mm; height: 69mm; z-index: 0; }

/* La carta de servicios (portada) */
.carta { display: flex; gap: 3mm; margin: 2mm 0 0; }
.carta > div { flex: 1; min-width: 0; border: 1px solid var(--linea); border-top: 2.4mm solid var(--rojo); background: var(--hueso); padding: 3mm 2.8mm; border-radius: 2mm; box-shadow: 0 .3mm 1.1mm rgba(10,10,11,.08); }
.carta .l { font-size: 7pt; letter-spacing: 2pt; font-weight: 800; color: var(--rojo); }
.carta .c { display: flex; width: 9mm; height: 9mm; border-radius: 50%; background: var(--negro); color: var(--rojo); align-items: center; justify-content: center; margin: 1.5mm 0 2mm; }
.carta b { display: block; font-size: 9.6pt; line-height: 1.2; }
.carta p { font-size: 8.2pt; color: #4d4d52; margin: 1mm 0 0; line-height: 1.3; }

/* Situaciones sin / con */
.rejilla { display: flex; flex-wrap: wrap; gap: 3.2mm; margin: 3mm 0; }
.sit { flex: 0 0 calc(50% - 1.6mm); border: 1px solid var(--linea); background: #fff; overflow: hidden; border-radius: 2mm; box-shadow: 0 .3mm 1.1mm rgba(10,10,11,.08); }
.sit .cab { display: flex; align-items: center; gap: 2.4mm; padding: 2.4mm 3mm; background: var(--hueso); border-bottom: 1px solid var(--linea); }
.sit .ico { flex: 0 0 8.5mm; height: 8.5mm; border-radius: 50%; background: var(--negro); color: var(--rojo); display: flex; align-items: center; justify-content: center; }
.sit .cab b { font-size: 9.8pt; display: block; line-height: 1.15; }
.sit .cab .cuando { font-size: 7.8pt; color: var(--humo); }
.sit .fila { padding: 2.3mm 3mm 2.3mm 3.4mm; font-size: 8.8pt; border-left: 3px solid; }
.sit .mal { background: var(--mal-f); border-color: var(--mal); }
.sit .bien { background: var(--bien-f); border-color: var(--bien); position: relative; }
.sit .fila small { display: flex; align-items: center; gap: 1.2mm; font-size: 6.8pt; letter-spacing: 1.3pt; text-transform: uppercase; font-weight: 700; margin-bottom: .6mm; }
.sit .mal small { color: var(--mal); }
.sit .bien small { color: var(--bien); }

/* Tarjetas de cifras / ángulos */
.tarjs { display: flex; flex-wrap: wrap; gap: 3.2mm; margin: 3mm 0; }
.tarj { flex: 0 0 calc(33.333% - 2.2mm); border: 1px solid var(--linea); border-top: 2.4mm solid var(--rojo); background: var(--hueso); padding: 3.4mm 3.2mm; border-radius: 2mm; box-shadow: 0 .3mm 1.1mm rgba(10,10,11,.08); }
.tarj .cifra { font-size: 24pt; font-weight: 800; line-height: 1; letter-spacing: -1pt; }
.tarj .cifra small { font-size: 8.6pt; font-weight: 700; color: var(--rojo); letter-spacing: 0; }
.tarj b { display: block; font-size: 9.6pt; margin: 1.6mm 0 .8mm; }
.tarj p { font-size: 8.4pt; color: #4d4d52; margin: 0; }
.tarj .ico-t { float: right; width: 9mm; height: 9mm; border-radius: 50%; background: var(--negro); color: var(--rojo); display: flex; align-items: center; justify-content: center; }

/* Cajas de cuatro */
.cuatro { display: flex; gap: 3mm; margin: 2mm 0; }
.cuatro > div { flex: 1; min-width: 0; border: 1px solid var(--linea); background: var(--hueso); padding: 3mm 2.4mm; text-align: center; border-radius: 2mm; box-shadow: 0 .3mm 1.1mm rgba(10,10,11,.08); }
.cuatro .c { display: inline-flex; width: 10mm; height: 10mm; border-radius: 50%; background: var(--negro); color: var(--rojo); align-items: center; justify-content: center; margin-bottom: 1.5mm; }
.cuatro b { display: block; font-size: 9.2pt; line-height: 1.2; text-wrap: balance; }
.cuatro p { font-size: 8.2pt; color: #4d4d52; margin: .6mm 0 0; line-height: 1.3; }
.cuatro.seis > div { padding: 2.6mm 1.6mm; }
.cuatro.seis b { font-size: 8.4pt; }
.cuatro.seis p { font-size: 7.6pt; }

/* Regalos (lo que vi) */
.regalos { display: flex; flex-wrap: wrap; gap: 3mm 4mm; margin: 3mm 0; }
.regalo { flex: 0 0 calc(50% - 2mm); display: flex; gap: 2.6mm; align-items: flex-start; }
.regalo .num { flex: 0 0 7.5mm; height: 7.5mm; border-radius: 50%; background: var(--negro); color: var(--rojo); font-weight: 800; font-size: 9.5pt; display: flex; align-items: center; justify-content: center; }
.regalo b { display: block; font-size: 9.4pt; margin-bottom: .5mm; }
.regalo p { font-size: 8.4pt; color: #4d4d52; margin: 0; }

/* Banner y frase de cierre */
.banner { display: flex; gap: 3.5mm; align-items: center; background: var(--rojo-f); border: 1.3px solid var(--rojo); padding: 3.5mm 4mm; margin: 4mm 0 2mm; border-radius: 2mm; }
.banner .c { flex: 0 0 11mm; height: 11mm; border-radius: 50%; background: var(--negro); color: var(--rojo); display: flex; align-items: center; justify-content: center; }
.banner b { display: block; font-size: 10.2pt; margin-bottom: .6mm; text-wrap: balance; }
.banner p { font-size: 8.8pt; color: #4d4d52; margin: 0; }
.cierre-frase { margin-top: 4mm; padding: 6mm; background: var(--negro); color: #fff; font-size: 15pt; font-weight: 800; letter-spacing: -.3pt; line-height: 1.2; border-radius: 2mm; text-wrap: balance; }
.cierre-frase em { font-style: normal; color: var(--rojo); }

/* Chat */
.chat { display: flex; flex-direction: column; gap: 2mm; }
.burbuja { max-width: 90%; padding: 2mm 3mm; font-size: 8.6pt; border-radius: 3mm; }
.burbuja small { display: block; font-size: 6.6pt; letter-spacing: 1.2pt; text-transform: uppercase; font-weight: 700; margin-bottom: .5mm; }
.burbuja.cli { align-self: flex-start; background: var(--fino); border-bottom-left-radius: .8mm; }
.burbuja.cli small { color: var(--humo); }
.burbuja.bot { align-self: flex-end; background: var(--negro); color: #fff; border-bottom-right-radius: .8mm; }
.burbuja.bot small { color: var(--rojo); }

/* Tarifas del gimnasio */
.tarifas { display: flex; gap: 3mm; margin: 2mm 0; }
.tarifa { flex: 1; min-width: 0; background: var(--negro); color: #fff; padding: 3.4mm 3mm; border-radius: 2mm; position: relative; }
.tarifa.mas { outline: 2px solid var(--rojo); }
.tarifa .g { font-size: 6.8pt; letter-spacing: 1.6pt; text-transform: uppercase; color: #a1a1aa; font-weight: 700; }
.tarifa .p { font-size: 18pt; font-weight: 800; letter-spacing: -.6pt; margin: 1.2mm 0 0; line-height: 1; }
.tarifa .u { font-size: 7.6pt; color: #a1a1aa; margin: .8mm 0 2.6mm; line-height: 1.3; }
.tarifa .b { display: block; background: var(--rojo); color: #fff; text-align: center; font-size: 7pt; letter-spacing: 1.6pt; text-transform: uppercase; font-weight: 700; padding: 2mm 0; border-radius: 1mm; }

/* Planes (la carta de precios) */
.planes { display: flex; gap: 3.4mm; align-items: stretch; margin: 4mm 0 2mm; }
.plan { flex: 1; min-width: 0; position: relative; border: 1px solid var(--linea); border-radius: 2.4mm; background: var(--hueso); padding: 4.4mm 3.4mm 3.6mm; color: #4d4d52; }
.plan .nom { font-size: 10.4pt; margin: 0; }
.plan .nom b { font-weight: 800; color: var(--negro); }
.plan .nom .l { color: var(--rojo); font-weight: 800; }
.plan .lema { font-size: 8.4pt; margin: .6mm 0 3mm; min-height: 7.4mm; line-height: 1.25; }
.plan .precio { display: flex; align-items: flex-start; gap: 1.5mm; color: var(--negro); }
.plan .precio .cifra { font-size: 27pt; font-weight: 800; letter-spacing: -1.2pt; line-height: .9; }
.plan .precio .ud { font-size: 7.4pt; font-weight: 700; line-height: 1.15; padding-top: .8mm; }
.plan .antes { font-size: 8pt; color: var(--humo); text-decoration: line-through; margin: .8mm 0 0; }
.plan .mes { display: flex; gap: 2mm; align-items: center; padding: 2.2mm 2.4mm; border-radius: 1.6mm; background: #fff; border: 1px solid var(--linea); margin: 2.6mm 0 3mm; }
.plan .mes b { display: block; font-size: 9.6pt; color: var(--negro); line-height: 1.1; }
.plan .mes span { font-size: 7.6pt; color: var(--humo); }
.plan ul { list-style: none; margin: 0; padding: 0; }
.plan li { display: flex; gap: 1.8mm; align-items: flex-start; font-size: 8.4pt; line-height: 1.3; padding: 1.6mm 0; border-top: 1px solid var(--linea); color: var(--negro); }
.plan li svg { flex: 0 0 auto; margin-top: .5mm; color: var(--rojo); }
.plan.destacado { flex: 1.14; background: var(--negro); border-color: var(--negro); color: #c9c9cf; transform: scale(1.03); box-shadow: 0 1.2mm 4mm rgba(10,10,11,.3); padding-top: 6.4mm; }
.plan.destacado .nom b, .plan.destacado .precio { color: #fff; }
.plan.destacado .mes { background: #17171a; border-color: #2a2a2e; }
.plan.destacado .mes b { color: #fff; }
.plan.destacado .mes span, .plan.destacado .antes { color: #a1a1aa; }
.plan.destacado li { border-color: #2a2a2e; color: #f4f4f5; }
.plan .sello { position: absolute; top: -3mm; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--rojo); color: #fff; font-size: 7.2pt; letter-spacing: 1.6pt; text-transform: uppercase; font-weight: 800; padding: 1.3mm 3mm; border-radius: 1mm; }
.todos { display: flex; gap: 3mm; margin: 4mm 0 1mm; }
.todos > div { flex: 1; display: flex; gap: 2mm; align-items: flex-start; font-size: 8.6pt; line-height: 1.3; color: #4d4d52; }
.todos svg { flex: 0 0 auto; color: var(--rojo); margin-top: .3mm; }
.todos b { color: var(--negro); }

/* Cómo empezamos */
.necesito { list-style: none; margin: 2mm 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2.6mm 5mm; }
.necesito li { flex: 0 0 calc(50% - 2.5mm); display: flex; gap: 2mm; align-items: flex-start; font-size: 9.2pt; padding: 2.4mm 3mm; background: var(--hueso); border: 1px solid var(--linea); border-radius: 2mm; }
.necesito li svg { flex: 0 0 auto; margin-top: .6mm; color: var(--rojo); }
.clientes { display: flex; gap: 4mm; margin-top: 2mm; }
.cliente { flex: 1; text-align: center; }
.cliente .lg { height: 20mm; border: 1px solid var(--linea); border-radius: 2mm; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fff; }
.cliente .lg img { width: 100%; height: 100%; object-fit: contain; display: block; }
.cliente b { display: block; font-size: 9.4pt; margin-top: 1.8mm; }
.cliente span { font-size: 8pt; color: var(--humo); }
.contacto { display: flex; justify-content: space-between; align-items: center; gap: 6mm; background: var(--negro); color: #fff; border-radius: 2.4mm; padding: 7mm 7mm; margin-top: 6mm; }
.contacto .frase { margin: 0; font-size: 12.5pt; line-height: 1.35; font-weight: 700; text-wrap: balance; }
.contacto .quien { text-align: right; flex: 0 0 auto; }
.contacto .et { display: block; font-size: 7.6pt; letter-spacing: 2.2pt; text-transform: uppercase; color: var(--rojo); margin-bottom: 1.4mm; }
.contacto .quien b { display: block; font-size: 15pt; color: #fff; letter-spacing: -.3pt; }
.contacto .rol { display: block; font-size: 8.4pt; color: #a1a1aa; }
.contacto .tel { display: block; font-size: 15pt; font-weight: 800; color: var(--rojo); margin-top: .6mm; }

/* ===== Relleno por hoja: que cada una aproveche el alto ===== */
.p1 .portada h1 { font-size: 38pt; }
.p1 .portada .bajada { font-size: 13pt; margin-top: 7mm; }
.p1 .portada .p-deco { width: 84mm; height: 78mm; top: 8mm; }
.p1 .portada { padding-bottom: 9mm; margin-bottom: 8mm; }
.p1 .grande { font-size: 13pt; margin-bottom: 5mm; }
.p1 .carta { gap: 3.6mm; margin-top: 3mm; }
.p1 .carta > div { padding: 4.4mm 3.6mm; }
.p1 .carta .c { width: 11mm; height: 11mm; margin: 2.4mm 0 3mm; }
.p1 .carta b { font-size: 10.8pt; }
.p1 .carta p { font-size: 9.2pt; margin-top: 1.6mm; line-height: 1.4; }
.p1 .apunte { margin-top: 5mm; font-size: 9pt; }

.viejo3 .grande { font-size: 12.4pt; margin-bottom: 4mm; }
.viejo3 .apunte { font-size: 8.6pt; margin-top: 2.5mm; }
.viejo3 .regalos { gap: 3.6mm 6mm; margin: 4mm 0; }
.viejo3 .regalo .num { flex-basis: 8.5mm; height: 8.5mm; font-size: 10.5pt; }
.viejo3 .regalo b { font-size: 10pt; margin-bottom: .8mm; }
.viejo3 .regalo p { font-size: 9pt; }
.viejo3 .banner { padding: 4.4mm 5mm; margin-top: 4.5mm; }
.viejo3 .banner b { font-size: 11pt; } .viejo3 .banner p { font-size: 9.4pt; }

.viejo4 .grande { font-size: 13pt; margin-bottom: 5mm; }
.viejo4 .cuatro.seis { gap: 3.4mm; margin-top: 4mm; }
.viejo4 .cuatro.seis > div { padding: 4.4mm 2mm; }
.viejo4 .cuatro.seis .c { width: 12mm; height: 12mm; margin-bottom: 2.4mm; }
.viejo4 .cuatro.seis b { font-size: 9.8pt; } .viejo4 .cuatro.seis p { font-size: 8.6pt; margin-top: 1.2mm; }
.viejo4 .dos { margin-top: 7mm !important; gap: 5mm; }
.viejo4 .banner { padding: 5.5mm 5mm; }
.viejo4 .banner b { font-size: 11.5pt; } .viejo4 .banner p { font-size: 9.8pt; }
.viejo4 .epigrafe { margin-top: 7mm !important; }

.viejo6 .grande { font-size: 12.6pt; margin-bottom: 4.5mm; }
.viejo6 .tarifa { padding: 5mm 3.4mm; }
.viejo6 .tarifa .p { font-size: 22pt; } .viejo6 .tarifa .u { font-size: 8.4pt; margin-bottom: 3.6mm; } .viejo6 .tarifa .b { padding: 2.6mm 0; }
.viejo6 .apunte { font-size: 9pt; margin-top: 3mm; }
.viejo6 .cuatro { gap: 3.6mm; margin-top: 4mm; }
.viejo6 .cuatro > div { padding: 5mm 3mm; }
.viejo6 .cuatro .c { width: 12mm; height: 12mm; margin-bottom: 2.4mm; }
.viejo6 .cuatro b { font-size: 10.4pt; } .viejo6 .cuatro p { font-size: 9pt; margin-top: 1.4mm; }
.viejo6 .banner { padding: 5.5mm 5mm; margin-top: 7mm; }
.viejo6 .banner b { font-size: 11.5pt; } .viejo6 .banner p { font-size: 9.8pt; }

.p8 .planes { margin-top: 6mm; }
.p8 .plan { padding: 5.4mm 3.8mm 4.6mm; }
.p8 .plan.destacado { padding-top: 7.6mm; }
.p8 .plan .nom { font-size: 11.4pt; } .p8 .plan .lema { font-size: 9pt; margin-bottom: 3.6mm; }
.p8 .plan .precio .cifra { font-size: 31pt; } .p8 .plan .antes { font-size: 8.6pt; }
.p8 .plan .mes { padding: 3mm; } .p8 .plan .mes b { font-size: 10.6pt; }
.p8 .plan li { font-size: 9.2pt; padding: 2.3mm 0; }
.p8 .todos { margin-top: 6mm; } .p8 .todos > div { font-size: 9.4pt; }
.p8 .cierre-frase { font-size: 16.5pt; padding: 8mm 7mm; margin-top: 7mm; }

.viejo5 .grande { font-size: 12.6pt; }
.viejo5 .tarj { padding: 4mm 3.4mm; } .viejo5 .tarj p { font-size: 8.8pt; } .viejo5 .tarj b { font-size: 10pt; }
.viejo5 .burbuja { font-size: 9pt; padding: 2.4mm 3.2mm; } .viejo5 .chat { gap: 2.4mm; }

/* ===== Problema → solución ===== */
.ps { display: flex; align-items: stretch; gap: 0; margin: 3mm 0 0; }
.ps .lado { flex: 1; min-width: 0; border-radius: 2.4mm; padding: 3.4mm 3.4mm 3mm; display: flex; flex-direction: column; }
.ps .problema { background: var(--mal-f); border: 1px solid #d4d4d8; }
.ps .solucion { background: #fff; border: 2px solid var(--negro); box-shadow: 0 1mm 3mm rgba(10,10,11,.12); }
.ps .flecha { flex: 0 0 11mm; display: flex; align-items: center; justify-content: center; }
.ps .flecha span { width: 9mm; height: 9mm; border-radius: 50%; background: var(--rojo); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 .6mm 1.6mm rgba(220,31,38,.4); }
.ps .tag { align-self: flex-start; display: inline-flex; align-items: center; gap: 1.4mm; font-size: 7pt; letter-spacing: 1.8pt; text-transform: uppercase; font-weight: 800; padding: 1.2mm 2.6mm; border-radius: 1mm; }
.ps .problema .tag { background: #52525b; color: #fff; }
.ps .solucion .tag { background: var(--rojo); color: #fff; }
.ps h3 { font-size: 12pt; line-height: 1.15; margin: 2.4mm 0 1mm; font-weight: 800; text-wrap: balance; }
.ps .problema h3 { color: #3f3f46; }
.ps svg.dib { width: 100%; height: auto; margin: 1mm 0 1.5mm; }
.ps ul { list-style: none; margin: auto 0 0; padding: 0; }
.ps li { display: flex; gap: 1.8mm; align-items: flex-start; font-size: 8.8pt; line-height: 1.3; padding: 1.3mm 0; border-top: 1px solid rgba(10,10,11,.08); }
.ps li svg { flex: 0 0 auto; margin-top: .4mm; }
.ps .problema li svg { color: #71717a; }
.ps .solucion li svg { color: var(--bien); }

/* Lo que ganas: iconos grandes en fila */
.ganas { display: flex; gap: 3mm; margin: 4mm 0 0; }
.ganas > div { flex: 1; min-width: 0; display: flex; gap: 2.6mm; align-items: center; background: var(--negro); color: #fff; border-radius: 2mm; padding: 3.4mm 3.2mm; }
.ganas .c { flex: 0 0 11mm; height: 11mm; border-radius: 50%; background: var(--rojo); color: #fff; display: flex; align-items: center; justify-content: center; }
.ganas b { display: block; font-size: 10pt; line-height: 1.15; }
.ganas span { font-size: 8pt; color: #a1a1aa; line-height: 1.25; display: block; margin-top: .6mm; }

/* Solución general en cuatro iconos (hoja 2) */
.solucion4 { display: flex; align-items: center; gap: 2.4mm; background: var(--negro); color: #fff; border-radius: 2.4mm; padding: 4.4mm 4.4mm; margin-top: 4mm; }
.solucion4 .tit { flex: 0 0 34mm; font-size: 12pt; font-weight: 800; line-height: 1.15; }
.solucion4 .tit em { font-style: normal; color: var(--rojo); }
.solucion4 .s { flex: 1; text-align: center; }
.solucion4 .s .c { display: inline-flex; width: 11mm; height: 11mm; border-radius: 50%; background: var(--rojo); align-items: center; justify-content: center; margin-bottom: 1.4mm; }
.solucion4 .s b { display: block; font-size: 8.8pt; line-height: 1.15; }
.solucion4 .s span { font-size: 7.6pt; color: #a1a1aa; }
.solucion4 .mas { color: var(--rojo); font-weight: 800; font-size: 14pt; }

/* Lista numerada con iconos (hoja 3) */
.vi { display: flex; flex-wrap: wrap; gap: 2.6mm 4mm; margin: 3mm 0 0; }
.vi > div { flex: 0 0 calc(50% - 2mm); display: flex; gap: 2.4mm; align-items: flex-start; padding: 2.6mm 3mm; background: var(--hueso); border: 1px solid var(--linea); border-radius: 2mm; }
.vi .num { flex: 0 0 7mm; height: 7mm; border-radius: 50%; background: var(--rojo); color: #fff; font-weight: 800; font-size: 9pt; display: flex; align-items: center; justify-content: center; }
.vi b { display: block; font-size: 9.4pt; }
.vi p { font-size: 8.4pt; color: #4d4d52; margin: .4mm 0 0; }
.vi .arreglo { display: block; font-size: 8.2pt; color: var(--bien); font-weight: 700; margin-top: .8mm; }
.plan .ico-plan { display: flex; width: 10mm; height: 10mm; border-radius: 50%; background: var(--negro); color: var(--rojo); align-items: center; justify-content: center; margin-bottom: 2mm; }
.plan.destacado .ico-plan { background: var(--rojo); color: #fff; }
.p3 .vi > div { padding: 3.2mm 3.4mm; } .p3 .vi b { font-size: 10pt; } .p3 .vi p { font-size: 8.8pt; } .p3 .vi { gap: 3.2mm 4mm; margin-top: 4mm; }
.p3 .banner { margin-top: 5mm; padding: 4.4mm 5mm; }
.p4 .ganas > div, .p6 .ganas > div { padding: 4.4mm 3.4mm; } .p4 .ganas, .p6 .ganas { margin-top: 5mm; }
.p4 .cuatro.seis > div { padding: 3.6mm 1.6mm; } .p4 .cuatro.seis .c { width: 11mm; height: 11mm; }
.p7 .ganas { margin-top: 5mm; } .p7 .ganas > div { padding: 4.4mm 3.4mm; } .p7 .banner { margin-top: 5mm; }
.p7 .cierre-frase { margin-top: 5mm; font-size: 16pt; padding: 7mm 6mm; }
