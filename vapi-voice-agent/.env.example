# Puerto del servidor HTTP
PORT=3000

# Secreto compartido con Vapi. Si se define, el servidor exige la cabecera
# x-vapi-secret en cada peticion a /voice-webhook.
VAPI_SERVER_SECRET=

# URL publica del servidor (tunel de desarrollo o despliegue), sin barra final.
# Se usa para decirle a Vapi donde enviar los tool-calls de la llamada.
# Ejemplo: https://mi-tunel.ngrok-free.app
PUBLIC_SERVER_URL=

# Modelo del asistente, entre los que acepta el proveedor "anthropic" de Vapi.
# Por defecto: claude-haiku-4-5-20251001
VAPI_MODEL=

# Cuenta de servicio de Firebase en JSON o base64 de JSON. Si esta vacio, el
# servidor usa el negocio de ejemplo (src/db/fallbackBusiness.ts).
FIREBASE_SERVICE_ACCOUNT=

# Identificador del negocio por defecto cuando no llega ?business= en la URL.
DEFAULT_BUSINESS_ID=

# Contrasena del panel de pedidos (/pedidos). Usuario: cocina.
# Si esta vacia, el panel solo responde desde el propio ordenador. Ponle una
# antes de exponer el servidor a internet: el panel muestra direcciones y
# telefonos de clientes.
PANEL_PASSWORD=

# Grabar el audio de las llamadas: "si" para activarlo, vacio para no grabar.
# Vapi graba por defecto; aqui viene apagado. Si lo activas, el agente avisa al
# descolgar, porque grabar a un cliente obliga a informarle (ver README).
GRABAR_LLAMADAS=

# Voz del agente. Para elegirla: en el panel de Vapi, Resources > Voice Library,
# filtra por proveedor y por espanol, escucha las voces y copia el ID.
# Si la llamada deja de conectar tras cambiarla, la voz no es valida: vacia
# estas lineas y vuelve a la de serie (azure / es-ES-ElviraNeural).
#
# ElevenLabs (la que mas suena a persona; viene incluida en Vapi):
#   VOZ_PROVEEDOR=11labs
#   VOZ_ID=<el ID copiado de la Voice Library>
#   VOZ_MODELO=eleven_flash_v2_5   (el rapido; el unico al que se fuerza espanol)
#   VOZ_VELOCIDAD=1.05             (de 0.7 a 1.2; vale la coma: 1,05)
#
# Azure: VOZ_PROVEEDOR=azure y VOZ_ID=es-ES-XimenaMultilingualNeural, por ejemplo.
# VOZ_MODELO y VOZ_VELOCIDAD solo se usan con ElevenLabs.
VOZ_PROVEEDOR=
VOZ_ID=
VOZ_MODELO=
VOZ_VELOCIDAD=

# Sonido de fondo: "office" (murmullo de oficina, por defecto), "off" para
# silencio, o la URL publica de un audio propio (ambiente de cocina, de bar...).
SONIDO_FONDO=
