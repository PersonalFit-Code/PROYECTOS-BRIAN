# Puerto del servidor HTTP
PORT=3000

# Secreto compartido con Vapi. Si se define, el servidor exige la cabecera
# x-vapi-secret en cada peticion a /voice-webhook.
VAPI_SERVER_SECRET=

# URL publica del servidor (tunel de desarrollo o despliegue), sin barra final.
# Se usa para decirle a Vapi donde enviar los tool-calls de la llamada.
# Ejemplo: https://mi-tunel.ngrok-free.app
PUBLIC_SERVER_URL=

# Modelo del asistente, entre los que acepta el proveedor "anthropic" de Vapi.
# Por defecto: claude-haiku-4-5-20251001
VAPI_MODEL=

# Cuenta de servicio de Firebase en JSON o base64 de JSON. Si esta vacio, el
# servidor usa el negocio de ejemplo (src/db/fallbackBusiness.ts).
FIREBASE_SERVICE_ACCOUNT=

# Identificador del negocio por defecto cuando no llega ?business= en la URL.
DEFAULT_BUSINESS_ID=
