{
  "name": "vapi-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor Express + TypeScript que atiende los webhooks del agente de voz de Vapi.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prueba:pedido": "node scripts/pedido-de-prueba.mjs",
    "crear:negocio": "tsx scripts/crear-negocio.ts",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
