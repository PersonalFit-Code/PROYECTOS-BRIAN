# ── Asistente IA (chat con Claude) ─────────────────────────────────────────────
# Clave de la API de Anthropic (https://console.anthropic.com/). Se pone en Vercel →
# Settings → Environment Variables, NUNCA aquí (el repositorio es público).
# Sin ella la app funciona igual y el chat responde buscando en el temario.
# Pon un límite de gasto en la consola de Anthropic y deja la recarga automática apagada.
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-sonnet-5.
ASISTENTE_MODEL=
