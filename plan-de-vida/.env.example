# Copiar a .env.local para desarrollo. En Vercel se ponen en Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com). Sin ella el coach funciona en modo básico (sin IA).
ANTHROPIC_API_KEY=
# Opcional: modelo del coach (por defecto claude-sonnet-5-5)
# COACH_MODEL=claude-sonnet-5-5

# Cron de Vercel: cadena larga aleatoria (openssl rand -hex 32)
CRON_SECRET=

# Cotizaciones. Sin clave se usa Yahoo Finance (gratis, sin registro); con clave, Twelve Data.
# TWELVEDATA_API_KEY=

# Notificaciones push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# SOLO desarrollo: entrar sin login como este usuario (ignorado en producción)
# APP_SIN_LOGIN=1
# APP_USER_ID=
