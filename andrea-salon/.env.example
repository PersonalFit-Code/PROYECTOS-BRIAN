# Copiar a .env.local. En Vercel se pegan en Settings → Environment Variables.
# Las claves NO van al repositorio: este fichero solo dice cuáles existen.

# --- Dominio ---------------------------------------------------------------
# Vacías = modo rutas (andreasalonnails.vercel.app/es/reservar, /panel).
# Con dominio: https://andreasalon.es, https://reservar.andreasalon.es, https://panel.andreasalon.es
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RESERVAR_URL=
NEXT_PUBLIC_PANEL_URL=

# --- Supabase (proyecto en Fráncfort) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor. En Vercel marcarla como "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (cuenta de ANDREA; sk_test en Preview, sk_live en Production) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Correo (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Andrea Salón <citas@andreasalon.es>"
EMAIL_REPLY_TO=

# --- Tareas programadas y enlaces firmados -----------------------------------
# CRON_SECRET lo genera Vercel al activar los crons. TOKEN_SECRET: 32 bytes en hex
# (openssl rand -hex 32); firma los enlaces de cita y de bono.
CRON_SECRET=
TOKEN_SECRET=

# --- Chat (opcional: sin clave, el asistente responde en modo sin conexión) --
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5

# --- CAPTCHA de la reserva (Cloudflare Turnstile; opcional, recomendado) -----
# Sin las dos, la reserva no pide comprobación. Ver docs/como-publicar.md §7.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
